{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Version-2 flat manifest profile; title and description carry shared project metadata. Hero records use the shared version-2 contract. See SCHEMA.md for the project-profile adapter and empty-manifest policy.",
  "title": "Mityane geometrics Hero manifest version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "description", "heroes"],
  "properties": {
    "schemaVersion": {"const": 2},
    "title": {"type": "string", "pattern": "\\S"},
    "description": {"type": "string", "pattern": "\\S"},
    "focusMilestones": {
      "type": "array", "maxItems": 2000, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "heroes": {"type": "array", "minItems": 0, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["id", "file"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "file": {"type": "string", "pattern": "^heroes/[0-9]{2,3}-[a-z0-9-]+\\.json$"}}}}
  }
}
