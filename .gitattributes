* text=auto eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
dependencies.lock text eol=lf

# Historical source capsules and evidence retain their exact recorded bytes.
/.archive/** -text -whitespace
/code/operations/counterfactuals/archive/TOOLSET-*.md -text -whitespace

# Preserve the exact bytes of the completed, hash-bound V16 study record.
/code/embeddings/evaluation/records/CPB-v16.temporal-001.json -text -whitespace
/code/embeddings/evaluation/protocols/cpb_v16_temporal_recovery_v1/recovery-train-derivation.json -text -whitespace

# Dashboard receipt identities bind these exact evidence bytes.
/code/embeddings/encoders/causal_patch_bottleneck_mae/family/evidence/** -text -whitespace

# Existing research/export pins bind the raw working-tree bytes, including EOLs.
/LICENSE -text -whitespace
/environment-image.json -text -whitespace
/code/embeddings/encoders/causal_patch_bottleneck_mae/versions/v16/provenance.json -text -whitespace
/code/embeddings/encoders/causal_patch_bottleneck_mae/family/migration/*.json -text -whitespace
